# ============================================================================
# AuraSketch AI - Arquivo de Exemplo de Configurações (.env)
# ============================================================================

# Porta do Servidor Node.js Local
PORT=4173

# Chave da API do Google Gemini (Obrigatório para gerar os esboços em grafite)
# Obtenha em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=sua_chave_gemini_aqui

# ============================================================================
# Gateway de Pagamento SyncPayments (SyncPay)
# ============================================================================
# URL Base oficial da API SyncPayments
SYNCPAY_API_URL=https://api.syncpayments.com.br

# Credenciais de API da SyncPayments (Obtenha em Integrações / API)
SYNCPAY_CLIENT_ID=
SYNCPAY_CLIENT_SECRET=

# Token de API ou Segredo do Webhook configurado na aba de Webhook da SyncPayments
SYNCPAY_API_KEY=
SYNCPAY_WEBHOOK_SECRET=

# Preço do Produto em BRL (Ex: 1.00 para testes ou 29.90 para produção)
PRICE_BRL=1.00

# ============================================================================
# Persistência Opcional na Vercel (Upstash Redis / Vercel KV)
# ============================================================================
KV_REST_API_URL=
KV_REST_API_TOKEN=
