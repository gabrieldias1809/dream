# ============================================================================
# AuraSketch AI — Variáveis de Ambiente (.env)
# Copie este arquivo para .env e preencha os valores
# ============================================================================

# Porta do servidor Node.js
PORT=4173

# URL pública do backend (usado para gerar a URL do webhook enviada à SyncPay)
# Exemplo: https://aurasketch-api.seudominio.com
APP_URL=https://SEU_BACKEND_EASYPANEL

# ============================================================================
# Google Gemini — Geração de imagens IA
# Obtenha em: https://aistudio.google.com/app/apikey
# ============================================================================
GEMINI_API_KEY=sua_chave_gemini_aqui

# ============================================================================
# Gateway de Pagamento SyncPayments (SyncPay)
# ============================================================================
# URL Base oficial da API SyncPayments
SYNCPAY_API_URL=https://api.syncpayments.com.br

# Credenciais de API (Obtenha em Integrações > API no painel SyncPay)
SYNCPAY_CLIENT_ID=
SYNCPAY_CLIENT_SECRET=

# Chave de API alternativa (caso não use Client ID + Secret)
SYNCPAY_API_KEY=

# Token secreto do Webhook (configure o mesmo valor no painel SyncPay > Webhook)
SYNCPAY_WEBHOOK_SECRET=

# Preço do produto em BRL
# Use 1.00 para testes, 29.90 (ou o valor real) para produção
PRICE_BRL=1.00
