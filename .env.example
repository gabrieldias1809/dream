# ============================================================================
# AuraSketch AI - Configurações de Ambiente (Vercel & Local)
# ============================================================================

# Porta do Servidor Local
PORT=4173

# URL Base da Aplicação (ex: https://seu-app.vercel.app ou http://localhost:4173)
APP_URL=http://localhost:4173

# Chave da API do Google Gemini (Geração de Imagens via Imagen / Gemini 2.5/3.1)
# Obtenha sua chave gratuitamente em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ============================================================================
# Integração Gateway de Pagamento SyncPay (Pix & Checkout)
# ============================================================================
# Chave de API fornecida no painel SyncPay (https://syncpayments.com.br)
SYNCPAY_API_KEY=
SYNCPAY_CLIENT_ID=
SYNCPAY_CLIENT_SECRET=
SYNCPAY_WEBHOOK_SECRET=

# URL Base da API da SyncPay (Padrão de Produção ou Sandbox)
SYNCPAY_API_URL=https://api.syncpay.com.br/v1

# Preço do Produto em BRL (Ex: 29.90)
PRICE_BRL=29.90

# ============================================================================
# Persistência Opcional na Vercel (Upstash Redis / Vercel KV)
# Caso não configurado, o sistema usa armazenamento automático local / cache.
# ============================================================================
KV_REST_API_URL=
KV_REST_API_TOKEN=
